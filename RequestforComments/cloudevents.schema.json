{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nl-istandaarden:generiek:cloudevents:v1",
  "title": "CloudEvent Data structure Netwerkmodel",
  "description": "JSON Schema voor (een batch van) notificaties en meldingen in een CloudEvent data-attribuut. Elk item in de array volgt de Eventdata-definitie.",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/Eventdata"
  },
  "$defs": {
    "Eventdata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp",
        "afzenderIDType",
        "afzenderID",
        "ontvangerIDType",
        "ontvangerID",
        "eventType",
        "subjectList"
      ],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Tijdstip van aanmaken, ISO-8601 compliant (GraphQL scalar DateTime)."
        },
        "afzenderIDType": {
          "$ref": "#/$defs/IDTypeEnum",
          "description": "Soort identificatietype van de afzender."
        },
        "afzenderID": {
          "type": "string",
          "description": "De identificatie van de afzender, in combinatie met afzenderIDType."
        },
        "ontvangerIDType": {
          "$ref": "#/$defs/IDTypeEnum",
          "description": "Soort identificatietype van de ontvanger."
        },
        "ontvangerID": {
          "type": "string",
          "description": "De identificatie van de ontvanger, in combinatie met ontvangerIDType."
        },
        "ontvangerKenmerk": {
          "type": ["string", "null"],
          "description": "Optioneel kenmerk van de ontvanger."
        },
        "eventType": {
          "type": "string",
          "description": "Type gebeurtenis. Notificatie.eventType of Melding.eventType. "
        },
        "subjectList": {
          "type": "array",
          "minItems": 1,
          "description": "Lijst met onderwerpen (entiteiten).",
          "items": { "$ref": "#/$defs/SubjectEntity" }
        }
      }
    },
    "IDTypeEnum": {
      "title": "IDTypeEnum",
      "description": "Codelijst met toegestane typen identificatie (iWlz Codelijsten).",
      "type": "string",
      "enum": ["AGB", "BSN", "KVK", "OIN", "UZOVI"]
    },
    "SubjectEntity": {
      "title": "SubjectEntity",
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "recordID"],
      "properties": {
        "subject": {
          "type": "string",
          "description": "Identificatie van het parent-object."
        },
        "recordID": {
          "type": "string",
          "description": "De unieke identifier van het betreffende record binnen het register waarop de notificatie of melding betrekking heeft."
        }
      }
    }
  }
}